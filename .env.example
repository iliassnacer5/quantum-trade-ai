# ============================================================
#  QUANTUM TRADE AI — Variables d'environnement (exemple)
#  Copier en `.env` et renseigner. NE JAMAIS committer `.env`.
# ============================================================

# ---- Environnement ----
ENVIRONMENT=dev                # dev | staging | prod
LOG_LEVEL=INFO

# ---- Backend / API ----
API_HOST=0.0.0.0
API_PORT=8000
# PROD : générer un secret aléatoire long (openssl rand -hex 32) et NE JAMAIS le commiter.
SECRET_KEY=change-me-with-a-long-random-string
# Durée de session, en minutes. 43200 = 30 jours (réglage du desk, déploiement PRIVÉ à 2 comptes).
# ATTENTION : il n'existe ni jeton de rafraîchissement ni révocation. Un jeton qui fuite reste
# valable toute cette durée, et le seul moyen de l'invalider est de changer SECRET_KEY — ce qui
# déconnecte tout le monde. Sur un déploiement OUVERT au public, revenir à 60.
ACCESS_TOKEN_EXPIRE_MINUTES=43200
CORS_ORIGINS=http://localhost:3000

# ---- Persistance ----
# true  = repositories en mémoire (dev rapide, sans DB)
# false = PostgreSQL (le docker-compose force déjà false pour le backend)
USE_IN_MEMORY_DB=true

# ---- Base de données (PostgreSQL + TimescaleDB) ----
POSTGRES_USER=quantum
POSTGRES_PASSWORD=quantum_dev_pwd
POSTGRES_DB=quantum
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://quantum:quantum_dev_pwd@postgres:5432/quantum

# ---- Redis (cache + pub/sub) ----
REDIS_URL=redis://redis:6379/0

# ---- Kafka / Redpanda (pipeline data) ----
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# ---- LLM (via LiteLLM) ----
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LITELLM_DEFAULT_MODEL=gemini/gemini-2.5-pro

# ---- Données marché (MVP: crypto) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
# FRED (gratuit, fredaccount.stlouisfed.org/apikeys) -> taux Fed + inflation pour l'agent macro.
# Sans clé, le VIX est récupéré gratuitement via Yahoo (l'agent macro reste actif).
FRED_API_KEY=

# ---- News / sentiment ----
# Finnhub (gratuit, finnhub.io/register) : news par ticker (actions, prioritaire) + catégorie
# crypto/forex. Alimente l'agent Sentiment.
FINNHUB_API_KEY=
NEWSAPI_KEY=
NEWSDATA_KEY=
MASSIVE_NEWS_KEY=

# ---- Facturation ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=

# ---- Alertes ----
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=                # ou SENDGRID_API_KEY
EMAIL_FROM=alerts@quantumtrade.ai
# SMTP Gmail direct (prioritaire sur Resend si rempli) : aucun nom de domaine requis.
# GMAIL_APP_PASSWORD = un "mot de passe d'application" (myaccount.google.com/apppasswords),
# jamais le mot de passe réel du compte.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
